{
  "name": "sonora-music-app",
  "version": "1.0.0",
  "description": "Sonora - Premium Local Music Player & Media Importer",
  "main": "electron/main.js",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "python -m uvicorn backend.server:app --reload --port 8765 --host 127.0.0.1",
    "dev:electron": "electron .",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND,ELECTRON\" -c \"magenta,cyan,green\" \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:web": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/status-bar": "^8.0.3",
    "clsx": "^2.1.0",
    "lucide-react": "^0.359.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^29.1.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "wait-on": "^7.2.0"
  }
}
